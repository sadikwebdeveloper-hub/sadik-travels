NODE_ENV=development
PORT=8787
HOST=0.0.0.0
APP_ORIGIN=http://localhost:8787
CORS_ORIGINS=http://localhost:8787
TRUST_PROXY=false
SERVE_STATIC=true
SQLITE_PATH=./data/sadik.sqlite

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=sadik-travels-api
JWT_AUDIENCE=sadik-travels-web
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
ADMIN_IDENTITIES=01713000000
SETTINGS_MASTER_KEY=replace-with-another-32-character-secret

# Live travel and payment providers
PROVIDER_MODE=live
TRAVEL_PROVIDER_BASE_URL=
TRAVEL_PROVIDER_API_KEY=
TRAVEL_PROVIDER_TIMEOUT_MS=12000
PAYMENT_MODE=live
PAYMENT_PROVIDER_BASE_URL=
PAYMENT_PROVIDER_API_KEY=
PAYMENT_WEBHOOK_SECRET=

# SMS gateway (custom JSON endpoint for local/initial OTP delivery)
SMS_PROVIDER=custom_gateway
SMS_GATEWAY_URL=https://flavor-experience-officially-desktops.trycloudflare.com/sms/send
SMS_GATEWAY_USERNAME=testuser
SMS_GATEWAY_PASSWORD=testpass

# BulkSMSBD fallback
BULKSMSBD_API_URL=https://bulksmsbd.net/api/smsapi
BULKSMSBD_API_KEY=
BULKSMSBD_SENDER_ID=

# SMTP email notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Local development only; set false for production
DEV_OTP_ECHO=true
LOG_LEVEL=info
