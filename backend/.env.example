# Runtime
NODE_ENV=development
PORT=8787
HOST=0.0.0.0
APP_ORIGIN=http://localhost:8787
CORS_ORIGINS=http://localhost:8787
TRUST_PROXY=false

# Security - replace every value before production
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=amy-api
JWT_AUDIENCE=amy-web
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
COOKIE_DOMAIN=
COOKIE_SECURE=false

# Admin identity allowlist; phone numbers may use 01XXXXXXXXX or +8801XXXXXXXXX
ADMIN_IDENTITIES=

# Data: mongodb for normal/prod; memory is only for a UI preview without MongoDB
DATA_MODE=mongodb
MONGODB_URI=mongodb://127.0.0.1:27017/amy
REDIS_URL=redis://localhost:6379

# Operational modes
PROVIDER_MODE=mock
PAYMENT_MODE=mock
DEV_OTP_ECHO=true
LOG_LEVEL=info

# Generic travel provider adapter - required when PROVIDER_MODE=live
TRAVEL_PROVIDER_BASE_URL=
TRAVEL_PROVIDER_API_KEY=
TRAVEL_PROVIDER_TIMEOUT_MS=12000

# Generic messaging adapter - required for production OTP delivery
SMS_PROVIDER_URL=
SMS_PROVIDER_TOKEN=
EMAIL_PROVIDER_URL=
EMAIL_PROVIDER_TOKEN=

# Generic payment adapter - required when PAYMENT_MODE=live
PAYMENT_PROVIDER_BASE_URL=
PAYMENT_PROVIDER_API_KEY=
PAYMENT_WEBHOOK_SECRET=
