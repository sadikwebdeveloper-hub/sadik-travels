# Runtime
NODE_ENV=development
PORT=8787
HOST=0.0.0.0
APP_ORIGIN=http://localhost:8787
CORS_ORIGINS=http://localhost:8787
TRUST_PROXY=false

# Security - replace every value before production
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=sadik-travels-api
JWT_AUDIENCE=sadik-travels-web
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
SERVE_STATIC=true

# Admin identity allowlist; phone numbers may use 01XXXXXXXXX or +8801XXXXXXXXX
ADMIN_IDENTITIES=

# Data
DATA_MODE=mongodb
MONGODB_URI=mongodb://127.0.0.1:27017/sadik_travels
REDIS_URL=redis://localhost:6379

# Live integrations; no fake catalogue or provider data is generated by the backend
PROVIDER_MODE=live
TRAVEL_PROVIDER_BASE_URL=
TRAVEL_PROVIDER_API_KEY=
TRAVEL_PROVIDER_TIMEOUT_MS=12000
PAYMENT_MODE=live
PAYMENT_PROVIDER_BASE_URL=
PAYMENT_PROVIDER_API_KEY=
PAYMENT_WEBHOOK_SECRET=

# BulkSMSBD transactional OTP/notification delivery
BULKSMSBD_API_URL=https://bulksmsbd.net/api/smsapi
BULKSMSBD_API_KEY=
BULKSMSBD_SENDER_ID=

# SMTP email notification delivery
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Development-only OTP fallback. Keep false when using BulkSMSBD and always false in production.
DEV_OTP_ECHO=false
LOG_LEVEL=info
